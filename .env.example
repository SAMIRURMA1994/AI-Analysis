# Public URL of the Ollama server on EC2. Do not append /api/chat.
OLLAMA_BASE_URL=http://56.112.61.98:11434
OLLAMA_MODEL=qwen2.5:1.5b
GITHUB_PERSONAL_ACCESS_TOKEN=replace-with-a-new-github-token
# GitHub's official MCP server. Requires Docker Desktop or Docker Engine.
GITHUB_MCP_COMMAND=docker
GITHUB_MCP_ARGS=run|-i|--rm|-e|GITHUB_PERSONAL_ACCESS_TOKEN|-e|GITHUB_TOOLSETS=repos,issues,pull_requests,users,context|ghcr.io/github/github-mcp-server
# Optional free local browser automation MCP server. Requires Node.js 18+.
PLAYWRIGHT_MCP_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y|@playwright/mcp@latest
# Optional MySQL MCP server. Keep disabled until MYSQL_DSN is configured.
MYSQL_MCP_ENABLED=false
MYSQL_MCP_COMMAND=docker
MYSQL_DSN=user:password@tcp(host.docker.internal:3306)/database?parseTime=true
MYSQL_MCP_ARGS=run|-i|--rm|-e|MYSQL_DSN|-e|MYSQL_MCP_EXTENDED=1|-e|MYSQL_MCP_STRICT_READ_ONLY=1|ghcr.io/askdba/mysql-mcp-server:latest
HOST=0.0.0.0
PORT=8000
LOCAL_SEARCH_ROOT=.
